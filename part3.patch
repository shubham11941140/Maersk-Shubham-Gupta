diff --git a/.github/workflows/llm-eval.yml b/.github/workflows/llm-eval.yml
new file mode 100644
index 0000000..ff61f13
--- /dev/null
+++ b/.github/workflows/llm-eval.yml
@@ -0,0 +1,47 @@
+# Manual, paid evaluation of the GenAI assistant against the REAL Claude API.
+# Regular CI never calls an LLM (tests use a scripted fake, so they are free and deterministic).
+#
+# Setup: Settings → Secrets and variables → Actions → New repository secret → ANTHROPIC_API_KEY
+# Run:   Actions → LLM eval → Run workflow
+
+name: LLM eval
+
+on:
+  workflow_dispatch:
+    inputs:
+      model:
+        description: "Claude model id"
+        default: "claude-haiku-5-5"
+        required: true
+
+permissions:
+  contents: read
+
+jobs:
+  live-assistant-tests:
+    name: Assistant vs real Claude (${{ inputs.model }})
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    env:
+      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
+      SCI_ASSISTANT_MODEL: ${{ inputs.model }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: requirements*.txt
+      - run: pip install -r requirements-dev.txt
+      - name: Fail early if the secret is missing
+        run: test -n "$ANTHROPIC_API_KEY" || { echo "::error::Add the ANTHROPIC_API_KEY repository secret"; exit 1; }
+      # The fixture builds the warehouse and starts the real API; the tests ask the brief's questions.
+      - name: pytest -m live_llm
+        run: pytest -m live_llm -v --junitxml=junit-llm.xml
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: llm-eval
+          path: |
+            junit-llm.xml
+            /tmp/pytest-of-*/**/assistant-*.jsonl
