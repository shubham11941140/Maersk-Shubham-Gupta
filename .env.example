# Copy to .env to override defaults. All settings use the SCI_ prefix.
SCI_ENVIRONMENT=local
SCI_LOG_LEVEL=INFO
SCI_PORT=8000
SCI_DB_PATH=data/warehouse/supply_chain.duckdb
SCI_MODEL_DIR=artifacts/model
SCI_DQ_REPORT_PATH=artifacts/dq_report.json
SCI_DEFAULT_PAGE_SIZE=20
SCI_MAX_PAGE_SIZE=100
# docker compose only
API_PORT=8000

# GenAI assistant (Part 3)
ANTHROPIC_API_KEY=
SCI_ASSISTANT_MODEL=claude-haiku-5-5
SCI_ASSISTANT_API_URL=http://localhost:8000
SCI_ASSISTANT_MAX_TOOL_CALLS_PER_QUESTION=6
SCI_ASSISTANT_MAX_TOOL_CALLS_PER_SESSION=40
